# Supabase — Project Settings > API Keys.
# This MUST be the SECRET key (starts with `sb_secret_`), not the publishable
# one. The secret key bypasses RLS so the agent can write leads/appointments.
# A publishable key (`sb_publishable_`) here will make every write fail with
# "new row violates row-level security policy". Never expose this key client-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vapi — https://dashboard.vapi.ai
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# Shared secret the dashboard app sends when calling /api/calls/trigger,
# and used to verify inbound webhooks actually come from Vapi.
AGENT_SERVICE_API_KEY=
VAPI_WEBHOOK_SECRET=

# The deployed URL of THIS app (e.g. https://your-agent.vercel.app).
# Only needed to run `npm run setup-assistant` — Vapi must be able to reach
# this URL from the internet, so it has to be a real deployment (or an
# ngrok/tunnel URL for local testing).
AGENT_PUBLIC_URL=
