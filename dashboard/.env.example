# Supabase — Project Settings > API Keys.
# This is the PUBLISHABLE key (starts with `sb_publishable_`) — it's safe in the
# browser because RLS restricts what it can read. Never put the secret key here:
# anything NEXT_PUBLIC_ is shipped to the browser and readable by anyone.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL of the deployed agent service (Vercel deployment #1)
AGENT_SERVICE_URL=
AGENT_SERVICE_API_KEY=
